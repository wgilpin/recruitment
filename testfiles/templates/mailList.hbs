<div>
  {{#each result}}
  {{@index}}
  <div class="fancy">
    <button id="mail{{mail_id}}" onclick="mail.clickMail('{{mail_id}}')" class="mails">
      <div class="subject">
        {{subject}}
      </div>
      <div class="from">
        <!-- TODO: define helper mailType -->
        From {{mailTypes recipient_type recipient_id.name}}
      </div>
      <div class="name">
        {{from.name}}
      </div>
    </button>
    <div class="allinside" id="_{{mail_id}}" style="display: none;">
    </div>
  </div>
  {{/each}}
</div>