<table id="wallet-table" style="width:100%" class='behinditall'>
  <div id='CurrentBalance' class='behinditall'>
    Characters Current balance is:<br/>
      <div class='balance'>
        {{isk result.balance}} ISK ({{result.balance_words}} ISK)
      </div>
      ===={{balance_words}}
  </div>
  <tr class='beginrow base-padding'>
    <th>Balance</th>
    <th>Amount</th>
    <th>Reason</th>
    <th>To who</th>
    <th>Date</th>
  </tr>
  <div id='Fontcolers'>
    {{#each result.transactions}}
    <tr class=" {{oddEven @index 'row0' 'row1'}} ">
      <td>{{isk balance}}</td>
      <td class="{{posNeg amount 'amountplus' 'amountneg'}}">{{isk amount}}</td>
      <td>{{description}}</td>
      <td>{{threeParty}}</td>
      <td>{{dateFormat date}}</td>
    </tr>
    {{/each}}
  </div>
</table>